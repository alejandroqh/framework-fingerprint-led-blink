#!/bin/sh
# Runs even when the watcher was killed before its Python cleanup could run.
for led in /sys/class/leds/chromeos:white:power /sys/class/leds/chromeos:multicolor:power; do
    # Skip when already active: rewriting the trigger flickers the LED.
    if [ -e "$led/trigger" ] && ! grep -qF '[chromeos-auto]' "$led/trigger"; then
        printf '%s\n' chromeos-auto > "$led/trigger"
    fi
done
# Avoid rapid restart loops if D-Bus or the LED is temporarily unavailable.
sleep 2

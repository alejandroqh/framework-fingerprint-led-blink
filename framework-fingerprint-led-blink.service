[Unit]
Description=Blink power-button LED while fprintd waits for a finger
After=dbus.service systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/framework-fingerprint-led-blink
ExecStopPost=/bin/sh -c 'for l in /sys/class/leds/chromeos:white:power /sys/class/leds/chromeos:multicolor:power; do [ -w $$l/trigger ] && ! grep -qF "[chromeos-auto]" $$l/trigger && echo chromeos-auto > $$l/trigger; done; true'
Restart=on-failure
RestartSec=2

# Unprivileged: a system user that may only write the LED (udev rule grants
# group fprint-led write access to its trigger and brightness files). Static,
# from sysusers.conf: dbus-daemon rejects DynamicUser= UIDs it cannot resolve.
User=fprint-led
Group=fprint-led
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# Sandbox
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target

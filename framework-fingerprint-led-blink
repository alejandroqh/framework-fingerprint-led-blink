#!/usr/bin/python3 -I
"""Blink the Framework Laptop (13 / 16) power-button LED while fprintd waits for a finger.

Runs unprivileged. Subscribes (via `gdbus monitor --dest`) only to signals sent
by the current owner of net.reactivated.Fprint; the bus stamps the sender, so
other users cannot spoof them. The LED blinks while fprintd's own
`finger-needed` device property is true, and is always handed back to the EC
(chromeos-auto) when it turns false, fprintd goes away, or after a safety
timeout.
"""
import re
import signal
import subprocess
import sys
import threading

LED = "/sys/class/leds/chromeos:white:power"
ON_S, OFF_S = 0.25, 0.25
MAX_BLINK_S = 60          # safety: never blink longer than this
BUS_NAME = "net.reactivated.Fprint"

# gdbus monitor line for a finger-needed change on a device object, e.g.
# /net/reactivated/Fprint/Device/0: org.freedesktop.DBus.Properties.PropertiesChanged
#   ('net.reactivated.Fprint.Device', {'finger-needed': <true>}, @as [])
FINGER_NEEDED = re.compile(
    r"^(/net/reactivated/Fprint/Device/\w+): "
    r"org\.freedesktop\.DBus\.Properties\.PropertiesChanged "
    r"\('net\.reactivated\.Fprint\.Device', \{[^}]*'finger-needed': <(true|false)>"
)
# gdbus monitor prints these when fprintd's bus name loses / changes owner.
OWNER_CHANGE = re.compile(rf"^The name {re.escape(BUS_NAME)} (does not have an owner|is owned by )")

stop_evt = threading.Event()
lock = threading.Lock()
blinker = None


def write(name, value):
    try:
        with open(f"{LED}/{name}", "w") as f:
            f.write(value)
    except OSError as e:
        print(f"LED write {name}={value} failed: {e}", file=sys.stderr)


def restore():
    write("trigger", "chromeos-auto")


def blink_loop(evt):
    write("trigger", "none")
    elapsed = 0.0
    try:
        while not evt.is_set() and elapsed < MAX_BLINK_S:
            write("brightness", "100")
            if evt.wait(ON_S):
                break
            write("brightness", "0")
            if evt.wait(OFF_S):
                break
            elapsed += ON_S + OFF_S
    finally:
        restore()


def start_blink():
    global blinker, stop_evt
    with lock:
        if blinker and blinker.is_alive():
            return
        stop_evt = threading.Event()
        blinker = threading.Thread(target=blink_loop, args=(stop_evt,), daemon=True)
        blinker.start()


def stop_blink():
    with lock:
        stop_evt.set()
        t = blinker
    if t:
        t.join(timeout=2)


def shutdown(*_):
    stop_blink()
    restore()
    sys.exit(0)


def main():
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    restore()
    proc = subprocess.Popen(
        ["gdbus", "monitor", "--system", "--dest", BUS_NAME],
        stdout=subprocess.PIPE, text=True, bufsize=1,
    )
    waiting = set()          # device paths whose finger-needed is true
    for line in proc.stdout:
        line = line.rstrip("\n")
        m = FINGER_NEEDED.match(line)
        if m:
            path, value = m.groups()
            if value == "true":
                waiting.add(path)
            else:
                waiting.discard(path)
        elif OWNER_CHANGE.match(line):
            waiting.clear()   # fprintd exited or was replaced: nothing is waiting
        else:
            continue
        if waiting:
            start_blink()
        else:
            stop_blink()
    # gdbus ended unexpectedly: restore the LED and exit non-zero so systemd restarts us.
    stop_blink()
    restore()
    sys.exit(1)


if __name__ == "__main__":
    main()

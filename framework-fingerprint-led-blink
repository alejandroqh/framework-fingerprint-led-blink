#!/usr/bin/python3 -I
"""Blink the Framework Laptop (13 / 16) power-button LED while fprintd waits for a finger.

Runs unprivileged. Subscribes (via `gdbus monitor --dest`) only to signals sent
by the current owner of net.reactivated.Fprint; the bus stamps the sender, so
other users cannot spoof them. The LED blinks while fprintd's own
`finger-needed` device property is true and `finger-present` is false, and is
always handed back to the EC (chromeos-auto) when a finger touches the sensor,
`finger-needed` turns false, fprintd goes away, or after a safety timeout.
"""
import os
import re
import signal
import subprocess
import sys
import threading

LED = "/sys/class/leds/chromeos:white:power"
# Older Framework 13 (Intel 11th-13th gen) expose the power LED as a
# multicolor LED instead; it is used when LED does not exist.
LED_FALLBACK = "/sys/class/leds/chromeos:multicolor:power"
COLOR = "white"           # channel to light on multicolor LEDs
ON_S, OFF_S = 0.25, 0.25
MAX_BLINK_S = 60          # safety: never blink longer than this
BUS_NAME = "net.reactivated.Fprint"

# gdbus monitor line for a property change on a device object, e.g.
# /net/reactivated/Fprint/Device/0: org.freedesktop.DBus.Properties.PropertiesChanged
#   ('net.reactivated.Fprint.Device', {'finger-needed': <false>, 'finger-present': <false>}, @as [])
DEVICE_PROPS = re.compile(
    r"^(/net/reactivated/Fprint/Device/\w+): "
    r"org\.freedesktop\.DBus\.Properties\.PropertiesChanged "
    r"\('net\.reactivated\.Fprint\.Device', \{([^}]*)\}"
)
FINGER_PROP = re.compile(r"'finger-(needed|present)': <(true|false)>")
# gdbus monitor prints these when fprintd's bus name loses / changes owner.
OWNER_CHANGE = re.compile(rf"^The name {re.escape(BUS_NAME)} (does not have an owner|is owned by )")

stop_evt = threading.Event()
lock = threading.Lock()
blinker = None


if not os.path.exists(f"{LED}/trigger") and os.path.exists(f"{LED_FALLBACK}/trigger"):
    LED = LED_FALLBACK

saved_intensity = None    # multicolor: channel intensities to put back afterwards


def read(name):
    try:
        with open(f"{LED}/{name}") as f:
            return f.read().strip()
    except OSError:
        return None


def write(name, value):
    try:
        with open(f"{LED}/{name}", "w") as f:
            f.write(value)
    except OSError as e:
        print(f"LED write {name}={value} failed: {e}", file=sys.stderr)


def select_color():
    """On a multicolor LED, light only COLOR while blinking (default is often red)."""
    global saved_intensity
    channels = (read("multi_index") or "").split()
    if len(channels) < 2 or COLOR not in channels:
        return
    saved_intensity = read("multi_intensity")
    write("multi_intensity", " ".join("100" if c == COLOR else "0" for c in channels))


def restore():
    global saved_intensity
    if saved_intensity is not None:
        write("multi_intensity", saved_intensity)
        saved_intensity = None
    # Every trigger write turns the LED off and on again, even for the active
    # trigger, so a crash-looping service would look like constant blinking.
    if "[chromeos-auto]" not in (read("trigger") or ""):
        write("trigger", "chromeos-auto")


def blink_loop(evt):
    write("trigger", "none")
    select_color()
    elapsed = 0.0
    try:
        # Off first: the power LED is normally lit, so starting with "on"
        # would show no visible change for the first ON_S.
        while not evt.is_set() and elapsed < MAX_BLINK_S:
            write("brightness", "0")
            if evt.wait(OFF_S):
                break
            write("brightness", "100")
            if evt.wait(ON_S):
                break
            elapsed += ON_S + OFF_S
    finally:
        restore()


def start_blink():
    global blinker, stop_evt
    with lock:
        if blinker and blinker.is_alive():
            return
        stop_evt = threading.Event()
        blinker = threading.Thread(target=blink_loop, args=(stop_evt,), daemon=True)
        blinker.start()


def stop_blink():
    with lock:
        stop_evt.set()
        t = blinker
    if t:
        t.join(timeout=2)


def shutdown(*_):
    # Unwind first: a signal can arrive while start_blink holds the lock.
    # Cleanup in main's finally block must run after that lock is released.
    sys.exit(0)


def main():
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    restore()
    proc = subprocess.Popen(
        ["gdbus", "monitor", "--system", "--dest", BUS_NAME],
        stdout=subprocess.PIPE, text=True, bufsize=1,
    )
    try:
        # Device paths whose finger-needed / finger-present property is true.
        flags = {"needed": set(), "present": set()}
        for line in proc.stdout:
            line = line.rstrip("\n")
            if m := DEVICE_PROPS.match(line):
                path, props = m.groups()
                changes = FINGER_PROP.findall(props)
                if not changes:
                    continue
                for prop, value in changes:
                    if value == "true":
                        flags[prop].add(path)
                    else:
                        flags[prop].discard(path)
            elif OWNER_CHANGE.match(line):
                # fprintd exited or was replaced: nothing is waiting
                for paths in flags.values():
                    paths.clear()
            else:
                continue
            # Stop as soon as a finger touches: fprintd keeps finger-needed
            # true for ~1.4 s after a match. finger-present can only suppress
            # blinking, never start it.
            if flags["needed"] - flags["present"]:
                start_blink()
            else:
                stop_blink()
    finally:
        stop_blink()
        restore()
        # runit does not have systemd's cgroup cleanup: reap our monitor ourselves.
        if proc.poll() is None:
            proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        proc.stdout.close()
    # Unexpected monitor exit: let the service supervisor restart us.
    sys.exit(1)


if __name__ == "__main__":
    main()

#!/usr/bin/python3 -I
"""Blink the Framework Laptop (13 / 16) power-button LED while fprintd waits for a finger.

Runs unprivileged. Listens on the system bus and acts only on signals whose
sender is the current owner of net.reactivated.Fprint; the bus stamps the
sender, so other users cannot spoof them. The LED blinks while fprintd's own
`finger-needed` device property is true and `finger-present` is false, and is
always handed back to the EC (chromeos-auto) when a finger touches the sensor,
`finger-needed` turns false, fprintd goes away, or after a safety timeout.
"""
import os
import signal
import sys
import threading

from jeepney import HeaderFields, MatchRule, Message, MessageType, message_bus
from jeepney.io.blocking import open_dbus_connection

LED = "/sys/class/leds/chromeos:white:power"
# Older Framework 13 (Intel 11th-13th gen) expose the power LED as a
# multicolor LED instead; it is used when LED does not exist.
LED_FALLBACK = "/sys/class/leds/chromeos:multicolor:power"
COLOR = "white"           # channel to light on multicolor LEDs
ON_S, OFF_S = 0.25, 0.25
MAX_BLINK_S = 60          # safety: never blink longer than this
BUS_NAME = "net.reactivated.Fprint"
DEVICE_IFACE = f"{BUS_NAME}.Device"
DEVICE_PATHS = "/net/reactivated/Fprint/Device"
DBUS = "org.freedesktop.DBus"

# Signals to subscribe to. The bus resolves the well-known sender name to
# fprintd's current owner, but anyone may also send a signal straight to us and
# the bus delivers it regardless of these rules, so handle() re-checks senders.
PROPS_RULE = MatchRule(
    type="signal", sender=BUS_NAME, interface=f"{DBUS}.Properties",
    member="PropertiesChanged", path_namespace=DEVICE_PATHS,
)
PROPS_RULE.add_arg_condition(0, DEVICE_IFACE)
OWNER_RULE = MatchRule(type="signal", sender=DBUS, interface=DBUS, member="NameOwnerChanged")
OWNER_RULE.add_arg_condition(0, BUS_NAME)

stop_evt = threading.Event()
lock = threading.Lock()
blinker = None

fprintd: str | None = None   # fprintd's unique bus name (e.g. ":1.452") while it runs
# Device paths whose finger-needed / finger-present property is true.
flags: dict[str, set[str]] = {"finger-needed": set(), "finger-present": set()}


if not os.path.exists(f"{LED}/trigger") and os.path.exists(f"{LED_FALLBACK}/trigger"):
    LED = LED_FALLBACK

saved_intensity = None    # multicolor: channel intensities to put back afterwards


def read(name):
    try:
        with open(f"{LED}/{name}") as f:
            return f.read().strip()
    except OSError:
        return None


def write(name, value):
    try:
        with open(f"{LED}/{name}", "w") as f:
            f.write(value)
    except OSError as e:
        print(f"LED write {name}={value} failed: {e}", file=sys.stderr)


def select_color():
    """On a multicolor LED, light only COLOR while blinking (default is often red)."""
    global saved_intensity
    channels = (read("multi_index") or "").split()
    if len(channels) < 2 or COLOR not in channels:
        return
    saved_intensity = read("multi_intensity")
    write("multi_intensity", " ".join("100" if c == COLOR else "0" for c in channels))


def restore():
    global saved_intensity
    if saved_intensity is not None:
        write("multi_intensity", saved_intensity)
        saved_intensity = None
    write("trigger", "chromeos-auto")


def blink_loop(evt):
    write("trigger", "none")
    select_color()
    elapsed = 0.0
    try:
        # Off first: the power LED is normally lit, so starting with "on"
        # would show no visible change for the first ON_S.
        while not evt.is_set() and elapsed < MAX_BLINK_S:
            write("brightness", "0")
            if evt.wait(OFF_S):
                break
            write("brightness", "100")
            if evt.wait(ON_S):
                break
            elapsed += ON_S + OFF_S
    finally:
        restore()


def start_blink():
    global blinker, stop_evt
    with lock:
        if blinker and blinker.is_alive():
            return
        stop_evt = threading.Event()
        blinker = threading.Thread(target=blink_loop, args=(stop_evt,), daemon=True)
        blinker.start()


def stop_blink():
    with lock:
        stop_evt.set()
        t = blinker
    if t:
        t.join(timeout=2)


def handle(msg: Message) -> None:
    """Apply one signal from the bus, then start or stop blinking to match."""
    global fprintd
    fields = msg.header.fields
    sender = fields.get(HeaderFields.sender)
    path = fields.get(HeaderFields.path, "")
    match fields.get(HeaderFields.member), msg.body:
        case "NameOwnerChanged", (str(name), str(), str(new_owner)) if (
            sender == DBUS and name == BUS_NAME
        ):
            # fprintd started, exited or was replaced: nothing is waiting.
            fprintd = new_owner or None
            for paths in flags.values():
                paths.clear()
        case "PropertiesChanged", (str(iface), dict(changed), list()) if (
            fprintd is not None and sender == fprintd and iface == DEVICE_IFACE
            and path.startswith(f"{DEVICE_PATHS}/")
        ):
            for prop, paths in flags.items():
                match changed.get(prop):
                    case ("b", True):
                        paths.add(path)
                    case ("b", False):
                        paths.discard(path)
        case _:
            return
    # Stop as soon as a finger touches: fprintd keeps finger-needed true for
    # ~1.4 s after a match. finger-present can only suppress blinking, never
    # start it.
    if flags["finger-needed"] - flags["finger-present"]:
        start_blink()
    else:
        stop_blink()


def shutdown(*_):
    # Unwind first: a signal can arrive while start_blink holds the lock.
    # Cleanup in main's finally block must run after that lock is released.
    sys.exit(0)


def main():
    global fprintd
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    restore()
    try:
        # Filter before subscribing, so signals that arrive while we wait for
        # the replies below are queued rather than dropped.
        with open_dbus_connection(bus="SYSTEM") as conn, \
                conn.filter(MatchRule(type="signal"), bufsize=64) as signals:
            for rule in (PROPS_RULE, OWNER_RULE):
                reply = conn.send_and_get_reply(message_bus.AddMatch(rule))
                if reply.header.message_type == MessageType.error:
                    sys.exit(f"AddMatch failed: {reply.body}")
            # A NameOwnerChanged racing this lookup is queued and applied after it.
            reply = conn.send_and_get_reply(message_bus.GetNameOwner(BUS_NAME))
            if reply.header.message_type == MessageType.method_return:
                fprintd = reply.body[0]
            # Otherwise fprintd is not running yet; the bus starts it on demand.
            while True:
                handle(conn.recv_until_filtered(signals))
    except ConnectionError as e:
        print(f"D-Bus connection lost: {e}", file=sys.stderr)
    finally:
        stop_blink()
        restore()
    # Let the service supervisor restart us.
    sys.exit(1)


if __name__ == "__main__":
    main()
